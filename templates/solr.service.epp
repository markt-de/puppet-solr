<%- | String  $solr_base,
      String  $solr_user,
      String  $solr_include,
      String  $exec_start,
      Boolean $private_tmp,
| -%>
# THIS FILE IS MANAGED BY PUPPET
#
# Solr 10 dropped the init.d startup script in favor of systemd. This unit
# replaces the one generated by install_solr_service.sh so that the startup
# mode (SolrCloud vs. user-managed) and the location of the include file can
# be controlled by Puppet.
[Unit]
Description=Apache Solr
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=forking
User=<%= $solr_user %>
Environment=SOLR_INCLUDE=<%= $solr_include %>
ExecStart=<%= $exec_start %>
ExecStop=<%= $solr_base %>/bin/solr stop
Restart=on-failure
RestartSec=3s
TimeoutSec=180s
<% if $private_tmp { -%>
PrivateTmp=true
<% } -%>

[Install]
WantedBy=multi-user.target
